#!/usr/bin/env node

const optimize = require("svgo").optimize;
const fs = require("fs/promises");
const existsSync = require("fs").existsSync;
const mkdirSync = require("fs").mkdirSync;

async function generateIcons(sourcePath, destPath) {
  const files = await fs.readdir(sourcePath);
  const iconNames = [];

  if (!existsSync(destPath)) {
    mkdirSync(destPath);
  }

  await Promise.all(
    files
      .filter((fileName) => fileName.endsWith(".svg"))
      .map(async (fileName) => {
        const filePath = `${sourcePath}/${fileName}`;
        const svgText = await fs.readFile(filePath, {
          encoding: "utf8",
        });

        const optimizedSvg = optimize(svgText, {
          path: filePath,
          plugins: [
            {
              name: "removeAttrs",
              params: {
                attrs:
                  "(fill|stroke|stroke-width|stroke-linecap|stroke-linejoin)",
              },
            },
          ],
        });
        await fs.writeFile(`${destPath}/${fileName}`, optimizedSvg.data);

        iconNames.push(fileName.replace(".svg", ""));
      })
  );
}

// Vendored icons that are not (or no longer) part of lucide-static — e.g. the
// `github` brand icon, which lucide removed in its 1.0 release. Copied verbatim
// after the lucide set so a full regeneration (including `rm -rf assets/icons`
// to prune removed icons) can't silently drop them.
async function copyCustomIcons(sourcePath, destPath) {
  if (!existsSync(sourcePath)) return;
  if (!existsSync(destPath)) mkdirSync(destPath);

  const files = await fs.readdir(sourcePath);
  await Promise.all(
    files
      .filter((fileName) => fileName.endsWith(".svg"))
      .map((fileName) =>
        fs.copyFile(`${sourcePath}/${fileName}`, `${destPath}/${fileName}`)
      )
  );
}

generateIcons("./node_modules/lucide-static/icons", "./assets/icons").then(() =>
  copyCustomIcons("./assets/custom-icons", "./assets/icons")
);
